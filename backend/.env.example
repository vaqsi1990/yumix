# Supabase Postgres (Project Settings → Database → ORM → Prisma)
# Use your Supabase DATABASE password — not JWT_SECRET
DATABASE_URL="postgresql://postgres.[project-ref]:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000,https://www.yumix.ge"

# Resend (https://resend.com) — after verifying yumix.ge use: Yumix <noreply@yumix.ge>
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Yumix <onboarding@resend.dev>"
