// Yumix — food delivery (Wolt / Bolt Food style)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  COURIER
  RESTAURANT_OWNER
  ADMIN
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  APPLE_PAY
  GOOGLE_PAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VehicleType {
  BICYCLE
  MOTORBIKE
  CAR
}

enum AddonCategory {
  FOOD
  DRINK
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  phone         String    @unique
  personalId    String?   @unique
  password      String
  birthDate     DateTime?
  avatar        String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  preferences   Json?

  addresses     Address[]
  restaurants   Restaurant[]
  orders        Order[]              @relation("UserOrders")
  deliveries    Order[]              @relation("CourierOrders")
  reviews       Review[]
  favorites     FavoriteRestaurant[]
  favoriteProducts FavoriteProduct[]
  notifications Notification[]
  cart          Cart?
  courier       Courier?
  assignedCoupons Coupon[]      @relation("CouponAssignee")
  createdCoupons  Coupon[]      @relation("CouponCreator")
  couponUsages    CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pending signup until 6-digit email code is verified
model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  payload   Json
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  city         String
  street       String
  building     String?
  entrance     String?
  floor        String?
  apartment    String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  deliveryNote String?
  isDefault    Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
}

model Restaurant {
  id             String  @id @default(cuid())
  owner          User    @relation(fields: [ownerId], references: [id])
  ownerId        String
  name           String
  slug           String  @unique
  description    String?
  logo           String?
  coverImage     String?
  phone          String
  email          String? @unique
  iban           String  @default("")
  city           String
  address        String
  latitude         Float?
  longitude        Float?
  deliveryRadius   Float?
  minimumOrder     Float?
  deliveryFee      Float?
  deliveryFeePerKm Float?
  isOpen         Boolean @default(true)
  isApproved     Boolean @default(false)

  categories        RestaurantCategoryRelation[]
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  reviews           Review[]
  workingHours      WorkingHour[]
  addOns            ProductAddon[]
  carts             Cart[]
  favorites         FavoriteRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantCategory {
  id    String  @id @default(cuid())
  name  String
  icon  String?
  image String?

  restaurants RestaurantCategoryRelation[]
}

model RestaurantCategoryRelation {
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  category     RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String

  @@id([restaurantId, categoryId])
}

model ProductCategory {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  sortOrder    Int        @default(0)

  products Product[]
}

model Product {
  id              String          @id @default(cuid())
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId    String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId      String
  name            String
  description     String?
  image           String?
  gallery         String[]        @default([])
  price           Float
  discountPrice   Float?
  calories        Int?
  preparationTime Int?
  weight          Int?
  foodType        String?
  spicinessLevel  String?
  allergens       Json?
  isHidden        Boolean         @default(false)
  outOfStock      Boolean         @default(false)
  isAvailable     Boolean         @default(true)
  deletedAt       DateTime?

  variants            ProductVariant[]
  customizationGroups ProductCustomizationGroup[]
  orderItems          OrderItem[]
  cartItems           CartItem[]
  favorites           FavoriteProduct[]
  homeFavoriteFood    HomeFavoriteFood?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCustomizationGroup {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  name          String
  description   String?
  kind          String   @default("option")
  required      Boolean  @default(false)
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  sortOrder     Int      @default(0)

  options ProductCustomizationOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCustomizationOption {
  id          String                    @id @default(cuid())
  group       ProductCustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  name        String
  price       Float                     @default(0)
  sortOrder   Int                       @default(0)
  isAvailable Boolean                   @default(true)

  cartSelections  CartItemCustomization[]
  orderSelections OrderItemCustomization[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Float

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model ProductAddon {
  id           String        @id @default(cuid())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  price        Float
  category     AddonCategory @default(FOOD)

  orderAddons OrderAddon[]
  cartAddons  CartAddon[]
}

model Cart {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  coupon       Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId     String?

  items CartItem[]

  createdAt DateTime @default(now())
}

model CartItem {
  id        String          @id @default(cuid())
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product         @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  quantity  Int
  price     Float

  addOns          CartAddon[]
  customizations  CartItemCustomization[]
}

model CartItemCustomization {
  id         String                     @id @default(cuid())
  cartItem   CartItem                   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  cartItemId String
  option     ProductCustomizationOption @relation(fields: [optionId], references: [id])
  optionId   String
  quantity   Int                        @default(1)
  price      Float
}

model CartAddon {
  id         String       @id @default(cuid())
  cartItem   CartItem     @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  cartItemId String
  addon      ProductAddon @relation(fields: [addonId], references: [id])
  addonId    String
  quantity   Int
  price      Float
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  user          User          @relation("UserOrders", fields: [userId], references: [id])
  userId        String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  courier       User?         @relation("CourierOrders", fields: [courierId], references: [id])
  courierId     String?
  address       Address       @relation(fields: [addressId], references: [id])
  addressId     String
  subtotal      Float
  deliveryFee   Float
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  estimatedTime Int?
  etaPrepMin    Int?
  etaPrepMax    Int?
  etaTravelMin  Int?
  etaTravelMax  Int?
  etaTotalMin   Int?
  etaTotalMax   Int?
  customerNote  String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId      String?

  items   OrderItem[]
  payment Payment?
  review  Review?
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product         @relation(fields: [productId], references: [id])
  productId String
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  quantity  Int
  price     Float
  total     Float

  addOns          OrderAddon[]
  customizations  OrderItemCustomization[]
}

model OrderItemCustomization {
  id          String                     @id @default(cuid())
  orderItem   OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  option      ProductCustomizationOption @relation(fields: [optionId], references: [id])
  optionId    String
  groupName   String
  optionName  String
  quantity    Int                        @default(1)
  price       Float
}

model OrderAddon {
  id          String       @id @default(cuid())
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  addon       ProductAddon @relation(fields: [addonId], references: [id])
  addonId     String
  quantity    Int
  price       Float
}

model Payment {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String        @unique
  provider      String
  transactionId String?
  amount        Float
  currency      String        @default("GEL")
  status        PaymentStatus
  paidAt        DateTime?

  createdAt DateTime @default(now())
}

model Courier {
  id               String      @id @default(cuid())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String      @unique
  vehicleType      VehicleType
  licenseNumber    String?
  isOnline         Boolean     @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  locationUpdatedAt DateTime?
  rating           Float?
}

model Review {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  order        Order      @relation(fields: [orderId], references: [id])
  orderId      String     @unique
  rating       Int
  comment      String?

  createdAt DateTime @default(now())
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  /// BALANCE — multi-use voucher that depletes by GEL amount
  type             String    @default("BALANCE")
  /// Initial balance in GEL
  value            Float
  /// Remaining balance in GEL
  remainingBalance Float
  minimumOrder     Float?
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  note             String?

  assignedTo   User?   @relation("CouponAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  createdBy    User?   @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?

  carts  Cart[]
  orders Order[]
  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponUsage {
  id       String  @id @default(cuid())
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId  String?
  amount   Float

  createdAt DateTime @default(now())
}

model FavoriteRestaurant {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  createdAt DateTime @default(now())

  @@unique([userId, restaurantId])
}

model FavoriteProduct {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id      String  @id @default(cuid())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  orderId String?
  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

model WorkingHour {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  day          Int
  openTime     String
  closeTime    String
  isClosed     Boolean    @default(false)
}

/// Homepage “სასურველი საკვები” — admin-picked products
model HomeFavoriteFood {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
